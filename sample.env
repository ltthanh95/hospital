# ==========================
# ASP.NET Core
# ==========================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_PORT=8080

# ==========================
# SQL Server
# ==========================
SQL_SERVER=sqlserver
SQL_PORT=1433

SQL_DATABASE=HospitalDb
SQL_USER=sa
SQL_PASSWORD=Hospital@12345!

SQL_PID=Developer

# ==========================
# JWT
# ==========================
Jwt__Key=change-me-to-a-long-random-secret-at-least-32-bytes
Jwt__Issuer=HospitalApi
Jwt__Audience=HospitalApiClients
Jwt__ExpiryMinutes=60

# ==========================
# CORS
# ==========================
# Comma-separated origins get exploded into an array by ASP.NET Core config
# binding (Cors__AllowedOrigins__0, __1, ... ) — set each index explicitly.
Cors__AllowedOrigins__0=https://your-frontend-domain.example

# ==========================
# Docker
# ==========================
COMPOSE_PROJECT_NAME=hospital